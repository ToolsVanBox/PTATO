params {

  ref_genome = 'BSgenome.Hsapiens.UCSC.hg38'
  genome_fasta = "${params.resource_dir}/resources/hg38/Homo_sapiens_assembly38.fasta"
  genome_fai = "${params.resource_dir}/resources/hg38/Homo_sapiens_assembly38.fasta.fai"
  genome_dict = "${params.resource_dir}/resources/hg38/Homo_sapiens_assembly38.dict"

  features {
    closest = [
      ["GENEBODY", "${params.resource_dir}/resources/hg38/features/genebody.sorted.bed", "-c 4,5,6,13 -o distinct,distinct,distinct,min"],
      ["SIMPLEREPEAT", "${params.resource_dir}/resources/hg38/features/simpleRepeats.feature.sorted.bed", "-c 4,5,6,10 -o distinct,distinct,distinct,min"]
    ]
    intersect = [
      ["TSB", "${params.resource_dir}/resources/hg38/features/genebody.sorted.bed", "-c 4,5,6,12 -o distinct,distinct,distinct,distinct"],
      ["REPLISEQ", "${params.resource_dir}/resources/hg38/features/all_RepliSeq_median.sorted.bed", " -c 4,5,6,10 -o distinct,distinct,distinct,median"]
    ]
  }

  smurf {
    config = "${params.resource_dir}/resources/hg38/smurf/config_15cov.ini"
  }

  shapeit {
    chroms = "${params.resource_dir}/resources/hg38/shapeit/chromosomes.txt"
    maps = "${params.resource_dir}/resources/hg38/shapeit/shapeit_maps/"
    reference = "${params.resource_dir}/resources/hg38/shapeit/Phasing_reference/"
  }

  gridss {
    viralreference = "${params.resource_dir}/resources/hg38/gridss/human_virus.fa"
    viralfai = "${params.resource_dir}/resources/hg38/gridss/human_virus.fa.fai"
  }

  gripss {
    breakend_pod = "${params.resource_dir}/resources/hg38/gripss/gridss_pon_single_breakend.bed"
    breakpoint_pon = "${params.resource_dir}/resources/hg38/gripss/gridss_pon_breakpoint.bedpe"
    breakpoint_hotspot = "${params.resource_dir}/resources/hg38/gripss/KnownFusionPairs.bedpe"
    pon = "${params.resource_dir}/resources/hg38/gripss/SV_breakends_withCobalt_excludelist_220228.bed"
  }

  cobalt {
    gc_profile = "${params.resource_dir}/resources/hg38/cobalt/GC_profile.1000bp.cnp"
    pon = "${params.resource_dir}/resources/hg38/cobalt/COBALT_PTA_Normalized_Full.txt"
  }

  svs {
    centromeres = "${params.resource_dir}/resources/hg38/svs/hg38_centromeres.txt"
    cytoband = "${params.resource_dir}/resources/hg38/svs/cytoBand_hg38.txt.gz"
  }

}
